/-- Catalogue code #4000: ((6,2,2)), m=11, a=[3, 4, 7, 9, 9, 10], S=[0, 6]. -/
def code_4000 : ExampleData 6 11 2 where
  a := ![(3 : ZMod 11), (4 : ZMod 11), (7 : ZMod 11), (9 : ZMod 11), (9 : ZMod 11), (10 : ZMod 11)]
  S := ![(0 : ZMod 11), (6 : ZMod 11)]
