/-- Catalogue code #2000: ((6,2,2)), m=10, a=[3, 5, 6, 6, 7, 7], S=[0, 9]. -/
def code_2000 : ExampleData 6 10 2 where
  a := ![(3 : ZMod 10), (5 : ZMod 10), (6 : ZMod 10), (6 : ZMod 10), (7 : ZMod 10), (7 : ZMod 10)]
  S := ![(0 : ZMod 10), (9 : ZMod 10)]
