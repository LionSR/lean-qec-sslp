/-- Code #3000 is a genuine distance-2 quantum code: logical states
    realizing its probabilities exist and detect every weight-1 Pauli error. -/
theorem code_3000_qec :
    ∃ ψ, SS.IsAmplitudes code_3000 ψ ∧ SS.HasDistance ψ 2 :=
  SS.OK_hasDistance2 code_3000 code_3000_ok (by decide) (by decide)

