/-- Catalogue code #9000: ((6,2,2)), m=14, a=[1, 5, 5, 7, 10, 13], S=[0, 11]. -/
def code_9000 : ExampleData 6 14 2 where
  a := ![(1 : ZMod 14), (5 : ZMod 14), (5 : ZMod 14), (7 : ZMod 14), (10 : ZMod 14), (13 : ZMod 14)]
  S := ![(0 : ZMod 14), (11 : ZMod 14)]
