  intro k
  fin_cases k <;>
    refine ⟨by decide, fun x hx => by fin_cases hx <;> norm_num [code_2500], ?_⟩ <;>
    norm_num [code_2500, Finset.sum_insert, Finset.mem_singleton, Finset.sum_singleton]
theorem code_2500_b4 : ZTypeKL' 2 code_2500.supp code_2500.prob code_2500.targetZ := by
  intro j i
