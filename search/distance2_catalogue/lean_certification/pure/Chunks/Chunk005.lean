/-- Catalogue code #2500: ((6,2,2)), m=11, a=[1, 1, 4, 7, 7, 9], S=[0, 5]. -/
def code_2500 : ExampleData 6 11 2 where
  a := ![(1 : ZMod 11), (1 : ZMod 11), (4 : ZMod 11), (7 : ZMod 11), (7 : ZMod 11), (9 : ZMod 11)]
  S := ![(0 : ZMod 11), (5 : ZMod 11)]
