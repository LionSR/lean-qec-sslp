/-- Catalogue code #12000: ((6,2,2)), m=15, a=[3, 6, 7, 7, 10, 11], S=[0, 1]. -/
def code_12000 : ExampleData 6 15 2 where
  a := ![(3 : ZMod 15), (6 : ZMod 15), (7 : ZMod 15), (7 : ZMod 15), (10 : ZMod 15), (11 : ZMod 15)]
  S := ![(0 : ZMod 15), (1 : ZMod 15)]
